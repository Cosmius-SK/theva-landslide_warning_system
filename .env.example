# Browser-safe Supabase public values
VITE_SUPABASE_URL=https://qgmvlsgzpvqabiupmnki.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Vercel values — NEVER prefix with VITE_
SUPABASE_URL=https://qgmvlsgzpvqabiupmnki.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
OPERATOR_ACCESS_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
APP_ORIGIN=https://YOUR_PREVIEW_DEPLOYMENT.vercel.app

# Server-only device authentication for the ESP32 telemetry endpoint.
# Configure only in local development or the development/Preview environment.
TELEMETRY_DEVICE_ID=theva-esp32-01
TELEMETRY_DEVICE_TOKEN=GENERATE_WITH_NODE_CRYPTO_RANDOMBYTES_32_BASE64URL
# For local telemetry API use only; the API still requires the exact Preview Supabase URL.
TELEMETRY_LOCAL_DEVELOPMENT_OVERRIDE=false
